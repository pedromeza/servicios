# ---- Supabase (Project Settings > API) ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...   # sirve la "anon key" o la "publishable key"
SUPABASE_SERVICE_ROLE_KEY=eyJ...       # solo la usa el cron del servidor, NUNCA se expone al navegador

# ---- Migraciones automáticas (Supabase > Connect > Session pooler, con tu contraseña de base de datos) ----
# Con esta variable, cada despliegue en Vercel aplica solo las migraciones nuevas de supabase/migrations/.
# Si la dejas vacía, las migraciones se ejecutan a mano en el SQL Editor.
DATABASE_URL=postgresql://postgres.xxxxxxxx:TU_CONTRASEÑA@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# ---- Cifrado de datos sensibles (32 bytes en base64). Genera una con: openssl rand -base64 32 ----
# Si pierdes esta llave, los datos cifrados NO se pueden recuperar. Guárdala en un lugar seguro.
ENCRYPTION_KEY=

# ---- Acceso: correos que pueden entrar, separados por coma (opcional pero recomendado) ----
ALLOWED_EMAILS=tu-correo@ejemplo.com

# ---- Avisos de renovación por correo (Resend) ----
RESEND_API_KEY=re_...
NOTIFY_EMAIL=tu-correo@ejemplo.com                 # a quién se avisa
FROM_EMAIL="PGPM MEX <onboarding@resend.dev>"   # cambia a tu dominio verificado en Resend
CRON_SECRET=                             # cualquier cadena larga aleatoria; Vercel la manda en el header del cron
